struct Foo {
    int a
    int b

    init(int a, int b) {
        self.a = a
        self.b = b
    }

    as int {
        return self.a - self.b
    }
}

struct Parent : Foo {
    int c

    init(int a, int b, int c) {
        super(self, a, b)
        self.c = c
    }
}


func main() -> int {
    Parent myStruct = new Foo(3, 1)

    return myStruct as int
}