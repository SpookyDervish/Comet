import io

struct Foo {
    int[*] numbers

    init() {
        self.numbers = new int[100]
    }

    destroy {
        drop self.numbers
    }
}

struct Bar : Foo {
    init() {
        super(self)
    }

    destroy {
        super(self)
    }
}

func main() -> int {
    Bar myStruct = new Bar()
    drop myStruct

    return 0
}