import io

struct List <T> {
    T[*] elements
    int capacity
    int length

    init() {
        self.length = 0
        self.capacity = 8
        self.elements = new T[self.capacity]
    }

    func append(T elem) -> void {
        self.elements : self.length = elem

        self.length += 1

        if self.length == self.capacity {
            self.capacity *= 2

            T[*] old = self.elements
            self.elements = new T[self.capacity]

            for int i in 0 .. self.length {
                self.elements:i = old:i
            }
        }

        return 0
    }

    func pop() -> T {
        self.length -= 1
        return self.elements : self.length
    }

    func at(int index) -> T {
        return self.elements : index
    }
}

func main() -> int {
    
    List<bool> myList = new List<bool>()

    
    for int i in 0 .. 100000 {
        myList.append(123)
    }
    
    return 0
}