#ext malloc: fun(usize) :: &u8

struct Pointer <T> {
    ptr: &T,
    capacity: usize
}

imp <T> Pointer <T> {
    fun init(capacity: usize) :: Self {
        ptr = new Self {
            ptr = malloc(capacity),
            capacity = capacity
        }

        ret ptr
    }
}

fun main() :: i64 {

    x = @Pointer<f16>.init(8)

    ret x.capacity != 8
}