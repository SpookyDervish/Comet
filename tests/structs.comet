import io

struct Vector {
    int x = 0
    int y = 0
    int z = 0

    init(int x, int y, int z) {
        self.x = x
        self.y = y
        self.z = z
    }

    func add(Vector other) -> void {
        self.x = self.x + other.x
        self.y = self.y + other.y
        self.z = self.z + other.z
    }
}

struct Child : Vector {
    init(int x, int y, int z) {
        super(self, x, y, z)
    }

    override func add(Vector other) -> void {
        io.print("overwritten!\n")
    }
}

func main() -> int {
    Vector myVector = new Vector(1, 2, 3)
    io.print("myVector.x = %n, myVector.y = %n, myVector.z = %n\n", myVector.x, myVector.y, myVector.z)

    myVector.add(new Vector(1, 2, 3))

    io.print("myVector.x = %n, myVector.y = %n, myVector.z = %n\n", myVector.x, myVector.y, myVector.z)

    Child myChildVector = new Child(1, 2, 3)

    myChildVector.add(new Vector(1, 2, 3))

    return myVector.y != 4
}